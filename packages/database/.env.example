# Dùng bởi Prisma CLI khi chạy npm scripts trực tiếp trong packages/database
# (db:push:cloud/local, db:seed:cloud, db:studio:*). Mỗi app cũng có .env.example
# riêng cho biến nó thực sự cần lúc runtime — file này chỉ phục vụ CLI/seed.

DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"
LOCAL_DATABASE_URL="file:./prisma/pos-local-dev.db"

# Tài khoản ADMIN đầu tiên (packages/database/prisma/seed.ts), có giá trị mặc
# định nếu bỏ trống — xem seed.ts.
SEED_ADMIN_EMAIL="admin@cbdaicafe.local"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Chủ quán"
