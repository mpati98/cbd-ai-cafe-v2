{
  "name": "cbd-ai-cafe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "voice:server": "whisper-server/start.sh",
    "tts:server": "tts-server/start.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev:all": "concurrently -n whisper,tts,next -c blue,magenta,green \"cd whisper-server && .venv/bin/uvicorn server:app --host 0.0.0.0 --port 8008\" \"cd tts-server && .venv/bin/uvicorn server:app --host 0.0.0.0 --port 8009\" \"next dev\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@huggingface/inference": "^4.13.27",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "next": "16.2.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
