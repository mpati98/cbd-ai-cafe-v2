{
  "name": "cbd-ai-cafe",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@9.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:push:cloud": "npm run db:push:cloud --workspace=@cbd/database",
    "db:push:local": "npm run db:push:local --workspace=@cbd/database",
    "db:seed:cloud": "npm run db:seed:cloud --workspace=@cbd/database",
    "db:studio:cloud": "npm run db:studio:cloud --workspace=@cbd/database"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.4.5"
  }
}
