# --- AI providers (đặt món, career-prediction, quiz) ---
# Anthropic (Claude) — powers order-chat/order-quiz/career-prediction/quiz-chat.
ANTHROPIC_API_KEY="sk-ant-..."
# Google Gemini — powers voice STT/TTS (src/lib/gemini.ts) và career-prediction image.
GEMINI_API_KEY="..."

# --- Local database (SQLite, file trong container/máy chạy pos-local) ---
LOCAL_DATABASE_URL="file:./pos-local.db"

# --- Đồng bộ lên apps/dashboard ---
# Cấp ở dashboard, tab "Quán & đồng bộ" (Stores) khi provision quán này —
# chỉ hiển thị 1 lần lúc tạo/cấp lại, dán nguyên vào đây.
STORE_API_KEY=""
# URL của apps/dashboard mà quán này đồng bộ lên.
DASHBOARD_URL="https://dashboard.example.com"

# --- Docker / HTTPS public qua Cloudflare Tunnel (docker-compose.yml) ---
# Next.js app KHÔNG đọc biến này — chỉ docker-compose.yml dùng để cấu hình
# service "cloudflared". Lấy token khi tạo tunnel ở Cloudflare Zero Trust
# dashboard — xem README.md phần "HTTPS qua Cloudflare Tunnel".
CLOUDFLARE_TUNNEL_TOKEN=""

# --- Docker / HTTPS LAN qua Caddy (dự phòng, không dùng mặc định) ---
# Chỉ cần nếu bật lại profile "lan" (docker compose --profile lan up -d caddy)
# — xem README.md phần "Phương án LAN-only".
#
# Subdomain khách truy cập qua WiFi quán (Cloudflare DNS-01, không proxy
# traffic thật — xem README.md).
DOMAIN="dalat.cbdaicafe.com"
# Cloudflare API Token — tạo ở https://dash.cloudflare.com/profile/api-tokens,
# scope "Zone.DNS: Edit", giới hạn riêng zone cbdaicafe.com. KHÔNG dùng token
# full quyền account (xem README.md).
CLOUDFLARE_API_TOKEN=""
