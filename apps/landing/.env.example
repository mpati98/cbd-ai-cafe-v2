# Neon Postgres — copy this file to ".env" and fill in your own project's values.
# Get both connection strings from the Neon dashboard: Project > Connect.

# Pooled connection — used at runtime via @prisma/adapter-neon (packages/database/src/cloud-client.ts)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Direct/unpooled connection — used by the Prisma CLI (packages/database, generate/db push/studio)
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"
