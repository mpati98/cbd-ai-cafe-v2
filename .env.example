# Neon Postgres — copy this file to ".env" and fill in your own project's values.
# Get both connection strings from the Neon dashboard: Project > Connect.

# Pooled connection — used by the app at runtime via @prisma/adapter-neon (src/lib/prisma.ts)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Direct/unpooled connection — used by the Prisma CLI (generate/db push/studio), see prisma.config.ts
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"
